{
  "name": "node",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "mocha DOTENV_CONFIG_PATH=.env.dev test/*.test.ts -r ts-node/register -r dotenv/config --timeout 10000 --reporter mochawesome",
    "staging": "node dist/index.js",
    "preprod": "node dist/index.js",
    "build-staging": "npx rimraf dist && tsc && node dist/index.js  dist/index.js",
    "build-preprod": "npx rimraf dist && tsc && node dist/index.js  dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only index.ts --watch src/*.ts",
    "lint": "eslint 'src/**/*.ts' --format=html --output-file=eslint-report_sales_ms.html",
    "clean": "rimraf dist",
    "start": "npx rimraf dist && tsc && nodemon dist/index.js .env.staging dist/index.js"
  },
  "author": "chennai",
  "license": "ISC",
  "dependencies": {
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^22.13.1",
    "body-parser": "^1.20.1",
    "csv-writer": "^1.6.0",
    "eslint": "^9.20.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^8.5.1",
    "mocha": "^11.1.0",
    "mongoose": "^6.7.4",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.20",
    "pg": "^8.8.0",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/morgan": "^1.9.3",
    "@types/sequelize": "^4.28.20",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sequelize-cli": "^6.6.2"
  }
}
